{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Sign-up page for the free live class "O arrebatamento no final dos tempos"
  // (Escatologia Completa, Eduardo Reis). Its own Worker, separate from the main site
  // Worker "escoladoreinoclub" (escoladoreino.com) — never deploy over that one.
  // For now it runs on its workers.dev address; add the Escola do Reino subdomain
  // later under "routes" (custom_domain) and set workers_dev to false.
  "name": "evento-escoladoreino",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // escatologia.escoladoreino.com: custom domain added in the dashboard (2026-10-31). Public DNS
  // for escoladoreino.com is served by Hostinger (dns-parking), not Cloudflare, so the
  // subdomain also needs a record there: CNAME escatologia -> escoladoreino.com.
  "routes": [{ "pattern": "escatologia.escoladoreino.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,

  // Static pages live in ./public; only /api/*, /entrar and /admin/* run the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/entrar", "/admin/*"]
  },

  // SAME database as escoladoreino.com (schema lives in ../escoladoreinoclub/migrations).
  // Sign-ups land in `leads` and show up in escoladoreino.com/admin. No migrations here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "escoladoreino-club",
      "database_id": "6be94edb-094c-4eb9-9f53-bfe8c62cb1c3"
    }
  ],

  // Per-IP limit on the sign-up endpoint (namespace_id: unique within the account).
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "4201", "simple": { "limit": 20, "period": 60 } }
  ],

  // Secrets: ADMIN_PASSWORD (protects /admin/inscritos.csv); META_CAPI_TOKEN (Conversions API, optional).
  "vars": {
    // WhatsApp group invite (https://chat.whatsapp.com/...). Empty = the thank-you page
    // shows "convite sendo liberado" instead of the button. Change here and redeploy.
    "WHATSAPP_GROUP_URL": "https://chat.whatsapp.com/BvEBC3xzuDuHVKp0eOp2Fe?s=cl&p=i&mlu=4&ilr=4&iam=2",
    // Identifies this class in leads.landing_path and in the events' data.
    "AULA_SLUG": "aula-arrebatamento",
    // Meta Pixel da Escola do Reino (same as escoladoreino.com). Conversions API needs the
    // secret META_CAPI_TOKEN (Events Manager → pixel → Settings → Conversions API → Generate token).
    "META_PIXEL_ID": "1818933942616750",
    "META_GRAPH_VERSION": "v23.0",
    "AULA_NOME": "O arrebatamento no final dos tempos (Escatologia Completa, 05/11 20h)"
  }
}
